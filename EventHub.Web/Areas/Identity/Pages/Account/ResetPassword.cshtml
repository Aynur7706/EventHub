@page
@model EventHub.Web.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<section class="auth-section auth-polished">
    <div class="auth-split">
        <div class="auth-visual">
            <img src="~/images/events/photos/tech-expo.jpg" asp-append-version="true" alt="Event technology" />
            <div class="auth-floating-stat"><strong>Reset</strong><span>Password</span></div>
            <div class="auth-visual-copy">
                <h2>Create a new password.</h2>
                <p>Use the generated token link to complete account recovery.</p>
            </div>
        </div>

        <div class="auth-card auth-polished-card">
            <span class="eyebrow">Security</span>
            <h1 class="h2 fw-bold mt-2">Reset password</h1>

            @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
            {
                <div class="checkin-message success">
                    <strong>Password updated</strong>
                    <span>@Model.StatusMessage</span>
                </div>
                <a class="btn btn-dark mt-3 w-100" asp-area="Identity" asp-page="/Account/Login">Back to login</a>
            }
            else
            {
                <form method="post" class="mt-4 auth-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input asp-for="Input.Code" type="hidden" />
                    <div class="mb-3">
                        <label class="form-label" asp-for="Input.Email"></label>
                        <input class="form-control" asp-for="Input.Email" readonly />
                        <span class="text-danger" asp-validation-for="Input.Email"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Input.Password"></label>
                        <input class="form-control" asp-for="Input.Password" />
                        <span class="text-danger" asp-validation-for="Input.Password"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Input.ConfirmPassword"></label>
                        <input class="form-control" asp-for="Input.ConfirmPassword" />
                        <span class="text-danger" asp-validation-for="Input.ConfirmPassword"></span>
                    </div>
                    <button class="btn btn-dark btn-lg w-100" type="submit">Reset Password</button>
                </form>
            }
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
