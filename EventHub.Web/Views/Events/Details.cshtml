@model EventHub.Web.ViewModels.EventDetailsViewModel
@{
    ViewData["Title"] = Model.Event.Title;
}

<section class="container public-section">
    @if (TempData["Status"] is not null)
    {
        <div class="alert alert-info">@TempData["Status"]</div>
    }
    <div class="event-detail-shell">
        <div class="event-detail-main">
            <div class="detail-image-wrap">
                <img class="detail-image" src="@Model.Event.ImageUrl" alt="@Model.Event.Title" />
                <span class="category-pill">@Model.Event.CategoryName</span>
                <span class="status-pill">Active</span>
            </div>
            <div class="detail-content-card">
                <h1>@Model.Event.Title</h1>
                <div class="detail-meta-row">
                    <span>@Model.Event.EventDate.ToString("h:mm tt")</span>
                    <span>@Model.Event.EventDate.ToString("MMMM dd, yyyy")</span>
                    <span>@Model.Event.Location</span>
                </div>
                <p>@Model.Event.Description</p>
                <div class="progress-line"><i style="width:@Math.Min(100, Model.Event.RegisteredTickets * 100 / Math.Max(1, Model.Event.Capacity))%"></i></div>
                <small>@Model.Event.RegisteredTickets/@Model.Event.Capacity tickets booked</small>
            </div>
        </div>
        <aside class="event-detail-side">
            <div class="attendee-ring-card">
                <h2>Attendee Rate</h2>
                <span>@Model.Event.RegisteredTickets Total Tickets Booked</span>
                <div class="donut-ring"><strong>@(Model.Event.Capacity == 0 ? 0 : Math.Min(100, Model.Event.RegisteredTickets * 100 / Model.Event.Capacity))%</strong><span>Booked</span></div>
            </div>
            <form asp-action="Register" asp-route-id="@Model.Event.Id" method="post" class="reservation-box">
                <h2>Reserve Ticket</h2>
                <dl class="detail-list">
                    <dt>Price</dt><dd>@(Model.Event.Price == 0 ? "Free" : $"${Model.Event.Price}")</dd>
                    <dt>Available</dt><dd>@Model.AvailableTickets tickets</dd>
                    <dt>Organizer</dt><dd>@Model.Event.OrganizerName</dd>
                </dl>
                <label class="form-label" for="ticketCount">Tickets</label>
                <input class="form-control" id="ticketCount" name="ticketCount" type="number" min="1" max="@Model.AvailableTickets" value="1" />
                <button class="btn btn-dark w-100 mt-3" type="submit">Reserve Ticket</button>
            </form>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-action="@(Model.IsSaved ? "Unsave" : "Save")" asp-route-id="@Model.Event.Id" method="post" class="reservation-box save-event-box">
                    <h2>@(Model.IsSaved ? "Saved Event" : "Save Event")</h2>
                    <p>@(Model.IsSaved ? "This event is saved in your profile." : "Save this event and review it later from your profile.")</p>
                    <button class="btn btn-dark w-100" type="submit">@(Model.IsSaved ? "Remove Saved Event" : "Save Event")</button>
                </form>
            }
        </div>
    </div>
</section>
