@model EventHub.Web.ViewModels.EventListViewModel
@{
    ViewData["Title"] = "Events";
}

<section class="public-page-shell">
    <div class="container">
        <div class="public-page-title">
            <div>
                <span class="eyebrow">Discover</span>
                <h1>Upcoming Events</h1>
            </div>
            <span class="page-count">@Model.Events.Count events</span>
        </div>
    </div>
</section>

<section class="container public-section">
    <form class="filter-bar" method="get">
        <input class="form-control" asp-for="Filter.Search" name="Search" placeholder="Search events" />
        <input class="form-control" asp-for="Filter.Location" name="Location" placeholder="City or venue" />
        <select class="form-select" asp-for="Filter.CategoryId" name="CategoryId">
            <option value="">All categories</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
        <input class="form-control" asp-for="Filter.MaxPrice" name="MaxPrice" placeholder="Max price" />
        <button class="btn btn-dark" type="submit">Filter</button>
    </form>

    <div class="public-card-grid mt-4">
        @foreach (var item in Model.Events)
        {
            <partial name="_EventCard" model="item" />
        }
    </div>
</section>
