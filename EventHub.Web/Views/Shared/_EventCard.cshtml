@model EventHub.Web.DTOs.EventDto

<article class="event-card h-100">
    <div class="event-card-image">
        <img src="@Model.ImageUrl" alt="@Model.Title" />
        <span class="category-pill">@Model.CategoryName</span>
        <span class="status-pill">Active</span>
    </div>
    <div class="event-card-body">
        <div class="event-title-row">
            <h3>@Model.Title</h3>
            <strong>@(Model.Price == 0 ? "Free" : $"${Model.Price}")</strong>
        </div>
        <div class="event-meta">
            <span>@Model.EventDate.ToString("MMMM dd, yyyy")</span>
            <span>@Model.EventDate.ToString("h:mm tt")</span>
            <span>@Model.Location</span>
        </div>
        <div class="progress-line"><i style="width:@Math.Min(100, Model.RegisteredTickets * 100 / Math.Max(1, Model.Capacity))%"></i></div>
        <div class="event-card-footer">
            <small>@Model.RegisteredTickets/@Model.Capacity tickets</small>
            <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.Id">Details</a>
        </div>
    </div>
</article>
