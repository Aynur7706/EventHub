@{
    ViewData["Title"] = "Contact";
}

<section class="public-page-shell contact-heading">
    <div class="container">
        <div class="public-page-title">
            <div>
                <span class="eyebrow">Contact</span>
                <h1>Let's plan the next event</h1>
                <p>EventHub helps organizers publish events, manage capacity and track registrations from one clean workspace.</p>
            </div>
        </div>
    </div>
</section>

<section class="container public-section">
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="contact-card h-100">
                <span class="eyebrow">Support</span>
                <h2 class="h3 fw-bold mt-2">EventHub Team</h2>
                <p class="text-muted">For organizer onboarding, partnership questions or technical support, contact the platform team.</p>
                <div class="contact-list">
                    <span>support@eventhub.local</span>
                    <span>Baku, Azerbaijan</span>
                    <span>Mon-Fri, 09:00-18:00</span>
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <form class="contact-form">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Full name</label>
                        <input class="form-control" placeholder="Your name" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input class="form-control" placeholder="name@example.com" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Message</label>
                        <textarea class="form-control" rows="6" placeholder="Tell us about your event"></textarea>
                    </div>
                    <div class="col-12">
                        <button class="btn btn-dark px-4" type="button">Send message</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>
