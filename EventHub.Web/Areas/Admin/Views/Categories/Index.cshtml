@model IEnumerable<EventHub.Web.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

<section class="admin-layout">
    <aside class="admin-sidebar">
        <strong>EventHub Admin</strong>
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        <a asp-area="Admin" asp-controller="Categories" asp-action="Index">Categories</a>
    </aside>
    <div class="admin-content">
        <h1 class="fw-bold mb-4">Categories</h1>
        <form class="d-flex gap-2 mb-4" asp-action="Create" method="post">
            <input class="form-control" name="name" placeholder="New category name" />
            <button class="btn btn-dark" type="submit">Add</button>
        </form>
        <div class="admin-table">
            <table class="table align-middle">
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Name</td>
                        <td class="text-end">
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
