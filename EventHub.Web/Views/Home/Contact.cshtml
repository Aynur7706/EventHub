@model EventHub.Web.ViewModels.ContactMessageViewModel
@{
    ViewData["Title"] = "Contact";
}

<section class="public-page-shell contact-heading">
    <div class="container">
        <div class="public-page-title">
            <div>
                <span class="eyebrow">Contact</span>
                <h1>Let's plan the next event</h1>
                <p>EventHub helps organizers publish events, manage capacity and track registrations from one clean workspace.</p>
            </div>
        </div>
    </div>
</section>

<section class="container public-section">
    @if (TempData["Status"] is not null)
    {
        <div class="alert alert-info">@TempData["Status"]</div>
    }

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="contact-card h-100">
                <span class="eyebrow">Support</span>
                <h2 class="h3 fw-bold mt-2">EventHub Team</h2>
                <p class="text-muted">For organizer onboarding, partnership questions or technical support, contact the platform team.</p>
                <div class="contact-list">
                    <span>support@eventhub.local</span>
                    <span>Baku, Azerbaijan</span>
                    <span>Mon-Fri, 09:00-18:00</span>
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <form class="contact-form" asp-action="Contact" method="post">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" asp-for="FullName">Full name</label>
                        <input class="form-control" asp-for="FullName" placeholder="Your name" />
                        <span class="text-danger" asp-validation-for="FullName"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="Email">Email</label>
                        <input class="form-control" asp-for="Email" placeholder="name@example.com" />
                        <span class="text-danger" asp-validation-for="Email"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label" asp-for="Message">Message</label>
                        <textarea class="form-control" asp-for="Message" rows="6" placeholder="Tell us about your event"></textarea>
                        <span class="text-danger" asp-validation-for="Message"></span>
                    </div>
                    <div class="col-12">
                        <button class="btn btn-dark px-4" type="submit">Send message</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
