@page
@model EventHub.Web.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<section class="auth-section">
    <div class="auth-card">
        <span class="eyebrow">Welcome back</span>
        <h1 class="h2 fw-bold mt-2">Login to EventHub</h1>
        <p class="text-muted">Admins and organizers are redirected to their workspace after login.</p>

        <form method="post" class="mt-4 auth-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label class="form-label" asp-for="Input.Email"></label>
                <input class="form-control" asp-for="Input.Email" autocomplete="username" />
                <span class="text-danger" asp-validation-for="Input.Email"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Input.Password"></label>
                <input class="form-control" asp-for="Input.Password" autocomplete="current-password" />
                <span class="text-danger" asp-validation-for="Input.Password"></span>
            </div>
            <label class="remember-row mb-4">
                <input asp-for="Input.RememberMe" />
                <span>
                    <strong>Remember me</strong>
                    <small>Keep me signed in on this device</small>
                </span>
            </label>
            <div class="d-grid gap-3">
                <button class="btn btn-dark btn-lg" type="submit">Login</button>
                <a class="btn btn-outline-dark" asp-area="Identity" asp-page="/Account/Register">Create account</a>
            </div>
        </form>

        <div class="demo-accounts mt-4">
            <strong>Demo accounts</strong>
            <span>admin@eventhub.local / EventHub123!</span>
            <span>organizer@eventhub.local / EventHub123!</span>
            <span>user@eventhub.local / EventHub123!</span>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
