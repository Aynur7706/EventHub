@model EventHub.Web.ViewModels.EventListViewModel
@{
    ViewData["Title"] = "EventHub";
}

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="eyebrow">Portfolio-ready event platform</span>
                <h1 class="display-4 fw-bold mt-3">EventHub</h1>
                <p class="lead text-muted mt-3">Create, manage, promote and reserve tickets for modern events with role-based workflows and dashboard analytics.</p>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a class="btn btn-dark btn-lg" asp-controller="Events" asp-action="Index">Explore events</a>
                    <a class="btn btn-outline-dark btn-lg" asp-controller="Organizer" asp-action="Create">Create event</a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="hero-panel">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fw-semibold">Live metrics</span>
                        <span class="badge text-bg-success">Active</span>
                    </div>
                    <div class="metric-grid">
                        <div><strong>@ViewBag.TotalEvents</strong><span>Events</span></div>
                        <div><strong>@ViewBag.TotalUsers</strong><span>Users</span></div>
                        <div><strong>@ViewBag.Registrations</strong><span>Tickets</span></div>
                        <div><strong>$@ViewBag.Revenue</strong><span>Revenue</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
        <div>
            <span class="eyebrow">Upcoming</span>
            <h2 class="h1 fw-bold mt-2">Featured events</h2>
        </div>
        <a class="btn btn-outline-dark" asp-controller="Events" asp-action="Index">View all</a>
    </div>
    <div class="row g-4">
        @foreach (var item in Model.Events.Take(3))
        {
            <div class="col-md-6 col-xl-4">
                <partial name="_EventCard" model="item" />
            </div>
        }
    </div>
</section>

<section class="container py-4">
    <div class="category-strip">
        @foreach (var category in Model.Categories)
        {
            <a asp-controller="Events" asp-action="Index" asp-route-categoryId="@category.Id">@category.Name</a>
        }
    </div>
</section>
