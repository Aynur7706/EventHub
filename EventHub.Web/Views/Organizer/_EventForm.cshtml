@model EventHub.Web.ViewModels.EventFormViewModel

<form method="post" enctype="multipart/form-data" class="form-shell">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CurrentImageUrl" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-4">
        <div class="col-lg-8">
            <label class="form-label" asp-for="Title"></label>
            <input class="form-control" asp-for="Title" />
            <span class="text-danger" asp-validation-for="Title"></span>
        </div>
        <div class="col-lg-4">
            <label class="form-label" asp-for="CategoryId">Category</label>
            <select class="form-select" asp-for="CategoryId" asp-items="Model.Categories"></select>
        </div>
        <div class="col-12">
            <label class="form-label" asp-for="Description"></label>
            <textarea class="form-control" asp-for="Description" rows="5"></textarea>
        </div>
        <div class="col-md-6">
            <label class="form-label" asp-for="Location"></label>
            <input class="form-control" asp-for="Location" />
        </div>
        <div class="col-md-3">
            <label class="form-label" asp-for="Price"></label>
            <input class="form-control" asp-for="Price" />
        </div>
        <div class="col-md-3">
            <label class="form-label" asp-for="Capacity"></label>
            <input class="form-control" asp-for="Capacity" />
        </div>
        <div class="col-md-6">
            <label class="form-label" asp-for="EventDate"></label>
            <input class="form-control" asp-for="EventDate" />
        </div>
        <div class="col-md-6">
            <label class="form-label" asp-for="Image"></label>
            <input class="form-control" asp-for="Image" accept=".jpg,.jpeg,.png,.webp" />
        </div>
    </div>
    <div class="d-flex gap-3 mt-4">
        <button class="btn btn-dark" type="submit">Save event</button>
        <a class="btn btn-outline-dark" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
