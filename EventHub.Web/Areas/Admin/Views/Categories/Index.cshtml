@model IEnumerable<EventHub.Web.Models.Category>
@{
    ViewData["Title"] = "Categories";
    ViewData["Breadcrumb"] = "Dashboard / Categories";
}

<section class="dashboard-panel">
    <form class="category-create" asp-action="Create" method="post">
        <input class="form-control" name="name" placeholder="New category name" />
        <button class="btn btn-dark" type="submit">Add Category</button>
    </form>
    <div class="category-admin-grid">
        @foreach (var item in Model)
        {
            <article class="category-admin-card">
                <strong>@item.Name</strong>
                <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                    <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                </form>
            </article>
        }
    </div>
</section>
