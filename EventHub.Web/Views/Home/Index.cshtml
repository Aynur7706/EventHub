@model EventHub.Web.ViewModels.EventListViewModel
@{
    ViewData["Title"] = "EventHub";
}

<section class="public-hero">
    <div class="container">
        <div class="public-hero-card">
            <div class="hero-copy">
                <span class="eyebrow">Modern event platform</span>
                <h1>Discover events, reserve tickets, manage everything.</h1>
                <p>EventHub brings public event discovery, ticket reservations and organizer analytics into one clean platform.</p>
                <div class="hero-actions">
                    <a class="btn btn-dark btn-lg" asp-controller="Events" asp-action="Index">Explore Events</a>
                    <a class="btn btn-light btn-lg" asp-controller="Home" asp-action="Contact">Contact Us</a>
                </div>
            </div>
            <div class="hero-dashboard-preview">
                <div class="preview-top">
                    <span>Dashboard</span>
                    <strong>Live Summary</strong>
                </div>
                <div class="metric-grid">
                    <div><strong>@ViewBag.TotalEvents</strong><span>Total Events</span></div>
                    <div><strong>@ViewBag.Registrations</strong><span>Tickets Sold</span></div>
                    <div><strong>@ViewBag.TotalUsers</strong><span>Users</span></div>
                    <div><strong>$@ViewBag.Revenue</strong><span>Revenue</span></div>
                </div>
                <div class="mini-bar-chart">
                    <span style="height: 46%"></span>
                    <span style="height: 78%"></span>
                    <span style="height: 92%"></span>
                    <span style="height: 64%"></span>
                    <span style="height: 84%"></span>
                    <span style="height: 56%"></span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container public-section">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Upcoming</span>
            <h2>Featured Events</h2>
        </div>
        <a class="btn btn-dark" asp-controller="Events" asp-action="Index">View All</a>
    </div>
    <div class="public-card-grid">
        @foreach (var item in Model.Events.Take(3))
        {
            <partial name="_EventCard" model="item" />
        }
    </div>
</section>

<section class="container public-section pt-0">
    <div class="category-strip">
        @foreach (var category in Model.Categories)
        {
            <a asp-controller="Events" asp-action="Index" asp-route-categoryId="@category.Id">@category.Name</a>
        }
    </div>
</section>
