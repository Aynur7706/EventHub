@model IEnumerable<EventHub.Web.Models.Event>
@{
    ViewData["Title"] = "Organizer";
    ViewData["Breadcrumb"] = "Dashboard / Events";
    Layout = "/Views/Shared/_DashboardLayout.cshtml";
}

<section class="event-toolbar">
    <div class="event-tabs">
        <button class="active">Published (@Model.Count(e => e.Status == EventHub.Web.Constants.EventStatuses.Published))</button>
        <button>Pending (@Model.Count(e => e.Status == EventHub.Web.Constants.EventStatuses.PendingReview))</button>
        <button>Rejected (@Model.Count(e => e.Status == EventHub.Web.Constants.EventStatuses.Rejected))</button>
        <button>Past (@Model.Count(e => e.EventDate < DateTime.Today))</button>
        <button>Draft (@Model.Count(e => e.Status == EventHub.Web.Constants.EventStatuses.Draft))</button>
    </div>
    <div class="toolbar-actions">
        <a class="btn btn-light" asp-area="Admin" asp-controller="Categories" asp-action="Index">All Category</a>
        <a class="btn btn-dark" asp-action="Create">Create Event</a>
    </div>
</section>

<section class="organizer-event-grid">
@foreach (var item in Model)
{
    var sold = item.Registrations.Sum(r => r.TicketCount);
    var percent = item.Capacity == 0 ? 0 : Math.Min(100, sold * 100 / item.Capacity);
    <article class="manage-event-card">
        <div class="manage-event-image">
            <img src="@item.ImageUrl" alt="@item.Title" />
            <span class="category-pill">@item.Category?.Name</span>
            <span class="status-pill">@item.Status</span>
        </div>
        <div class="manage-event-body">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <h2>@item.Title</h2>
                <strong>$@item.Price</strong>
            </div>
            <span>@item.EventDate.ToString("MMMM dd, yyyy")</span>
            <span>@item.EventDate.ToString("h:mm tt")</span>
            <span>@item.Location</span>
            @if (!string.IsNullOrWhiteSpace(item.AdminNote))
            {
                <span class="admin-note">Admin note: @item.AdminNote</span>
            }
            <div class="progress-line"><i style="width:@percent%"></i></div>
            <div class="d-flex justify-content-between align-items-center">
                <small>@percent% sold</small>
                <div class="event-card-actions">
                    @if (User.IsInRole("Admin") && item.Status != EventHub.Web.Constants.EventStatuses.Published)
                    {
                        <form asp-action="Publish" asp-route-id="@item.Id" method="post">
                            <button class="approve-btn" type="submit">Publish</button>
                        </form>
                        <form asp-action="Reject" asp-route-id="@item.Id" method="post" class="reject-event-form">
                            <input name="adminNote" placeholder="Reject reason" />
                            <button type="submit">Reject</button>
                        </form>
                    }
                    @if (User.IsInRole("Admin") && item.Status == EventHub.Web.Constants.EventStatuses.Published)
                    {
                        <form asp-action="MoveToDraft" asp-route-id="@item.Id" method="post">
                            <button class="draft-btn" type="submit">Draft</button>
                        </form>
                    }
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                        <button type="submit">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </article>
}
</section>
