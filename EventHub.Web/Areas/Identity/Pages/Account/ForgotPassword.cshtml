@page
@model EventHub.Web.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<section class="auth-section auth-polished">
    <div class="auth-split">
        <div class="auth-visual">
            <img src="~/images/events/photos/cybersecurity.jpg" asp-append-version="true" alt="Account security" />
            <div class="auth-floating-stat"><strong>Secure</strong><span>Identity flow</span></div>
            <div class="auth-visual-copy">
                <h2>Reset your password.</h2>
                <p>EventHub uses ASP.NET Identity tokens for account recovery.</p>
            </div>
        </div>

        <div class="auth-card auth-polished-card">
            <span class="eyebrow">Account recovery</span>
            <h1 class="h2 fw-bold mt-2">Forgot password</h1>
            <p class="text-muted">Enter your email. In development mode the reset link appears on this page.</p>

            <form method="post" class="mt-4 auth-form">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Input.Email"></label>
                    <input class="form-control" asp-for="Input.Email" autocomplete="username" />
                    <span class="text-danger" asp-validation-for="Input.Email"></span>
                </div>
                <button class="btn btn-dark btn-lg w-100" type="submit">Generate Reset Link</button>
            </form>

            @if (!string.IsNullOrWhiteSpace(Model.ResetLink))
            {
                <div class="demo-accounts mt-4">
                    <strong>Development reset link</strong>
                    <a href="@Model.ResetLink">@Model.ResetLink</a>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
