@page
@model EventHub.Web.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<style>
    .auth-polished { min-height: calc(100vh - 170px); display: grid; place-items: center; padding: 54px 16px; background: #f6f2eb; }
    .auth-split { width: min(100%, 1080px); display: grid; grid-template-columns: 1fr 540px; gap: 18px; }
    .auth-visual { min-height: 650px; overflow: hidden; position: relative; border: 1px solid #d7cfc4; border-radius: 8px; background: #050505; box-shadow: 0 18px 42px rgba(31,25,17,.14); }
    .auth-visual img { width: 100%; height: 100%; object-fit: cover; opacity: .78; }
    .auth-visual-copy { position: absolute; inset: auto 28px 28px 28px; color: #fff; }
    .auth-visual-copy h2 { max-width: 560px; font-size: clamp(2.2rem, 5vw, 4.3rem); line-height: .98; font-weight: 950; }
    .auth-visual-copy p { max-width: 520px; color: rgba(255,255,255,.82); }
    .auth-floating-stat { position: absolute; top: 28px; left: 28px; padding: 16px 18px; color: #050505; background: #fffaf3; border-radius: 8px; }
    .auth-floating-stat strong { display: block; font-size: 1.8rem; line-height: 1; }
    .auth-polished-card { width: 100%; padding: 34px; background: #e9e0d4; border: 1px solid #d7cfc4; border-radius: 8px; box-shadow: 0 18px 42px rgba(31,25,17,.14); }
    .auth-polished-card h1 { color: #050505; font-weight: 950; }
    .auth-polished-card .form-control { min-height: 48px; border-radius: 999px; border-color: #d2c9bd; background: #fffaf3; }
    .auth-polished-card .btn { border-radius: 999px; font-weight: 800; }
    @@media (max-width: 992px) { .auth-split { grid-template-columns: 1fr; } .auth-visual { min-height: 360px; } }
</style>

<section class="auth-section auth-polished">
    <div class="auth-split">
    <div class="auth-visual">
        <img src="~/images/events/photos/startup.jpg" asp-append-version="true" alt="Event networking" />
        <div class="auth-floating-stat"><strong>500+</strong><span>Seats managed</span></div>
        <div class="auth-visual-copy">
            <h2>Join events that fit your calendar.</h2>
            <p>Create an account, reserve tickets and track every booking from one clean place.</p>
        </div>
    </div>

    <div class="auth-card auth-card-wide auth-polished-card">
        <span class="eyebrow">Join EventHub</span>
        <h1 class="h2 fw-bold mt-2">Create your account</h1>
        <p class="text-muted">Reserve tickets, follow upcoming events and manage your registrations from one place.</p>

        @if (!string.IsNullOrWhiteSpace(Model.ConfirmationLink))
        {
            <div class="demo-accounts mt-4">
                <strong>Development confirmation link</strong>
                <a href="@Model.ConfirmationLink">@Model.ConfirmationLink</a>
                <span>Your account is signed in for demo use. In production this link would be emailed.</span>
            </div>
            <a class="btn btn-dark btn-lg w-100 mt-4" asp-area="" asp-controller="Home" asp-action="Index">Continue to EventHub</a>
        }
        else
        {
        <form method="post" class="mt-4 auth-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <input type="hidden" asp-for="Input.ShowConfirmationLink" value="true" />
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label" asp-for="Input.FullName"></label>
                    <input class="form-control" asp-for="Input.FullName" autocomplete="name" placeholder="Your full name" />
                    <span class="text-danger" asp-validation-for="Input.FullName"></span>
                </div>
                <div class="col-12">
                    <label class="form-label" asp-for="Input.Email"></label>
                    <input class="form-control" asp-for="Input.Email" autocomplete="username" placeholder="name@example.com" />
                    <span class="text-danger" asp-validation-for="Input.Email"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="Input.Password"></label>
                    <input class="form-control" asp-for="Input.Password" autocomplete="new-password" />
                    <span class="text-danger" asp-validation-for="Input.Password"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="Input.ConfirmPassword"></label>
                    <input class="form-control" asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                    <span class="text-danger" asp-validation-for="Input.ConfirmPassword"></span>
                </div>
            </div>

            <button class="btn btn-dark btn-lg w-100 mt-4" type="submit">Create account</button>
            <p class="auth-switch text-muted mt-4 mb-0">
                Already have an account?
                <a asp-area="Identity" asp-page="/Account/Login">Login</a>
            </p>
        </form>
        }
    </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
